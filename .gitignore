# On ne publie que les dossiers de TP (tp1/, tp2/, ...) et les fichiers de la racine du dépôt
/*
!/.gitignore
!/README.md
!/tp*/

# fichiers générés par make dans chaque TP (libpile.so reste publiée)
/tp*/obj/
/tp*/test_*
*.a
# sauf les fichiers de chaque étape de compilation (make etapes), publiés volontairement
!/tp*/compilation/*

# fichiers auxiliaires LaTeX
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
