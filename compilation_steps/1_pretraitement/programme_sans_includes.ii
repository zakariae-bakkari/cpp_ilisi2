
using namespace std;

int main()
{
    cout << "Demonstration des etapes de compilation" << endl;

    PileTableau<int> pile;

    for (int i = 1; i <= 5; i++)
    {
        pile.empiler(((i) * (i)));
        ;
    }

    cout << "Pile : ";
    pile.afficher();
    cout << endl;

    cout << "Depilement :";
    while (!pile.estVide())
        cout << " " << pile.depiler();
    cout << endl;

    cout << "Fichier : " << "programme.cpp" << ", ligne " << 64 << endl;
    return 0;
}
